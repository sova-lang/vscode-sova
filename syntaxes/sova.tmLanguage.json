{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Sova",
    "scopeName": "source.sova",
    "fileTypes": ["sova"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#numbers" },
        { "include": "#decorators" },
        { "include": "#functions" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.sova",
                    "begin": "///",
                    "end": "$"
                },
                {
                    "name": "comment.line.double-slash.sova",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.sova",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.sova",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.sova",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.template.sova",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        {
                            "name": "meta.embedded.expression.sova",
                            "begin": "\\$\\{",
                            "end": "\\}",
                            "patterns": [
                                { "include": "$self" }
                            ]
                        },
                        {
                            "name": "constant.character.escape.sova",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.sova",
                    "match": "'(\\\\.|[^'\\\\])'"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.sova",
                    "match": "\\b(if|else|for|while|return|guard|break|continue|when|in|step)\\b"
                },
                {
                    "name": "keyword.declaration.sova",
                    "match": "\\b(let|const|func|type|enum|interface|mixin|extern|new|package|import|on|using|synth|emit)\\b"
                },
                {
                    "comment": "Soft keywords (`where`, `to`, `append`) are valid identifiers everywhere in Sova except inside specific synth-grammar positions. The compiler's `softId` parser rule means user code can declare `func where()`, `package to`, etc. TextMate can't see semantic context, so we only highlight them as keywords when they appear in their syntactic neighbourhood — `for ... where cond`, `emit append`, `emit ... to ID` — and leave bare uses to fall through to identifier rendering. A few synth-syntax positions lose highlighting as a result; that's the right trade-off vs. mis-coloring every function or package named after a soft keyword.",
                    "name": "keyword.control.sova",
                    "match": "(?<=\\bin\\s)(?:\\b\\w+\\s+)?\\bwhere\\b"
                },
                {
                    "name": "keyword.declaration.sova",
                    "match": "\\bemit\\s+append\\b|(?<=\\bemit\\s)(?:\\w+\\s+)?\\bto\\b"
                },
                {
                    "name": "keyword.concurrency.sova",
                    "match": "\\b(async|go|defer|select|case|default)\\b"
                },
                {
                    "name": "keyword.modifier.sova",
                    "match": "\\b(private|shared|implements|with)\\b"
                },
                {
                    "name": "keyword.wire.sova",
                    "match": "\\b(wire|ruleset)\\b"
                },
                {
                    "name": "keyword.test.sova",
                    "match": "\\b(test|group|setup|setupAll|teardown|teardownAll|assert|asSession)\\b"
                },
                {
                    "name": "keyword.this.sova",
                    "match": "\\b(this)\\b"
                },
                {
                    "name": "constant.language.sova",
                    "match": "\\b(true|false|none)\\b"
                },
                {
                    "name": "storage.type.side.sova",
                    "match": "\\b(frontend|backend)\\b"
                },
                {
                    "match": "\\b(on)\\s+(synth)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.sova" },
                        "2": { "name": "storage.type.side.sova" }
                    }
                },
                {
                    "match": "\\b(on)\\s+(field|param|method|ctor|type|func|let)\\b",
                    "captures": {
                        "1": { "name": "keyword.declaration.sova" },
                        "2": { "name": "storage.type.target.sova" }
                    }
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.primitive.sova",
                    "match": "\\b(int|float|bool|string|char|any)\\b"
                },
                {
                    "name": "support.type.generic.sova",
                    "match": "\\b(option|map|chan)\\b"
                },
                {
                    "name": "entity.name.type.sova",
                    "match": "\\b([A-Z][A-Za-z0-9_]*)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.sova",
                    "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.sova",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "decorators": {
            "patterns": [
                {
                    "name": "meta.annotation.sova",
                    "begin": "(@)([A-Za-z_][A-Za-z0-9_]*)",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.annotation.sova" },
                        "2": { "name": "entity.name.function.decorator.sova storage.type.annotation.sova" }
                    },
                    "end": "(?=\\s)|(?=$)|(?=[^A-Za-z0-9_()])",
                    "patterns": [
                        {
                            "name": "meta.annotation.arguments.sova",
                            "begin": "\\(",
                            "end": "\\)",
                            "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.sova" } },
                            "endCaptures": { "0": { "name": "punctuation.section.parens.end.sova" } },
                            "patterns": [
                                { "include": "#strings" },
                                { "include": "#numbers" },
                                {
                                    "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*:",
                                    "captures": {
                                        "1": { "name": "variable.parameter.annotation.sova" }
                                    }
                                },
                                { "include": "$self" }
                            ]
                        }
                    ]
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.sova" },
                        "2": { "name": "entity.name.function.sova" }
                    }
                },
                {
                    "name": "entity.name.function.call.sova",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.sova",
                    "match": "(==|!=|<=|>=|&&|\\|\\||\\?\\?|->|=>|\\.\\.|<<|>>|[+\\-*/%&|^~!<>=])"
                }
            ]
        }
    }
}
